# All optional. The app runs with none of these set. No secrets or API keys are needed.

# Comma-separated origins allowed to call the API from a browser.
# Only needed when the frontend is served from a different origin (the Vite dev server).
KAUSHALNITI_CORS_ORIGINS=http://localhost:5173

# Folder holding demo/, processed/ and metadata/. Defaults to ./data
# KAUSHALNITI_DATA_DIR=

# Built frontend to serve at /. Defaults to ./frontend/dist; skipped if it does not exist.
# KAUSHALNITI_FRONTEND_DIST=
